@page "/"
@using UrlSaver.Components.UrlList
@using UrlSaver.Domain
@using UrlSaver.Features.GetBookmarks
@inject GetBookmarksService _service;
@inject IConfiguration Configuration

<PageTitle>Url Saver | Home</PageTitle>

<h2>Url Bookmarks</h2>
@if (!isConfigured)
{
    <div class="alert alert-warning" role="alert">
        Supabase is not configured. Set <code>SUPABASE_URL</code> and <code>SUPABASE_ANON_KEY</code> in Netlify environment
        variables.
    </div>
}
@if (bookmarks.Any())
{
    <UrlList bookmarks="@bookmarks" />
}
else
{
    <p>No elements</p>
}

@code {
    List<UrlBookmark> bookmarks = [];
    bool isConfigured;

    protected override async Task OnParametersSetAsync()
    {
        var url = Configuration["Supabase:Url"];
        var key = Configuration["Supabase:AnonKey"];
        isConfigured = !string.IsNullOrWhiteSpace(url) && !string.IsNullOrWhiteSpace(key);
        bookmarks = await _service.GetBookmarks();
    }

}