@using UrlSaver.Domain;

<div class="card" style="width: 25rem;">
  <div class="card-body">
    <h5 class="card-title">@bookmark.Name</h5>
    <h6 class="mb-2 text-body-secondary card-subtitle">@string.Join(", ", @bookmark.Tags)</h6>
    <p class="text-truncate card-text" style="max-height: 200px;">@bookmark.Description</p>
    <a href="@bookmark.Url" class="card-link">Link</a>
  </div>
</div>

@code {
  [Parameter]
  public UrlBookmark bookmark { get; set; } = new UrlBookmark{Name = "N/A", Url = "N/A", Description = "N/A"};
}