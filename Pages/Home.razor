@page "/"
@using UrlSaver.Features.GetBookmarks
@inject GetBookmarksService _service;
@inject IConfiguration Configuration

<PageTitle>Url Saver | Home</PageTitle>

<h2>Url Bookmarks</h2>

@if (_isLoading)
{
    <div class="bottom-0 position-fixed p-3 end-0">
    <div class="m-5 spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    </div>
}
else if (bookmarks.Any())
{
    <UrlList bookmarks="@bookmarks" />
}
else
{
    <p>No elements</p>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public int PageNo { get; set; } = 1;

    [Parameter]
    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 10;

    List<UrlBookmark> bookmarks = [];

    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        bookmarks = await _service.GetBookmarks(Search, PageNo, PageSize);
        _isLoading = false;
    }

}