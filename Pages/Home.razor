@page "/"
@using UrlSaver.Features.GetBookmarks
@inject GetBookmarksService _service;
@inject IConfiguration Configuration

<PageTitle>Url Saver | Home</PageTitle>

<h2>Url Bookmarks</h2>

@if (_isLoading)
{
    <div class="m-5 spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (bookmarks.Any())
{
    <UrlList bookmarks="@bookmarks" />
}
else
{
    <p>No elements</p>
}

@code {
    List<UrlBookmark> bookmarks = [];
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        bookmarks = await _service.GetBookmarks();
        _isLoading = false;
    }

}