@page "/Delete/{Id:int}"
@inject DeleteBookmarkService _service
@inject NavigationManager NavigationManager
<PageTitle>Url Saver | Delete</PageTitle>

<button class="btn btn-danger" @onclick="HandleDeleteClick">Delete</button>
<button class="btn btn-secondary" @onclick="HandleGoBackClick">Go back</button>

@code {
    [Parameter]
    public int Id { get; set; }

    public async Task HandleDeleteClick()
    {
        await _service.Delete(Id);
        NavigationManager.NavigateTo(NavigationManager.ToAbsoluteUri("").ToString());
    }

    public void HandleGoBackClick()
    {
        NavigationManager.NavigateTo(NavigationManager.ToAbsoluteUri("").ToString());
    }
}