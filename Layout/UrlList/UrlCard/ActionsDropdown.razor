@inject NavigationManager NavigationManager
@inject DeleteBookmarkService _service;

<div class="btn-group bookmark-actions">
    <button class="rounded-circle btn btn-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-three-dots"
             viewBox="0 0 16 16">
            <path
            d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
        </svg>
    </button>
    <ul class="dropdown-menu">
        <li><button class="dropdown-item" @onclick="HandleEditClick">Edit</button></li>
        <!-- Button trigger modal -->
        <button type="button" class="dropdown-item" @onclick="HandleDeleteClick">
            Delete
        </button>
    </ul>
</div>

@code {
    [Parameter]
    public int BookmarkId { get; set; } = -1;

    public void HandleEditClick()
    {
        NavigationManager.NavigateTo(NavigationManager.ToAbsoluteUri($"Edit/{BookmarkId}").ToString());
    }

    public async Task HandleDeleteClick()
    {
        NavigationManager.NavigateTo(NavigationManager.ToAbsoluteUri($"Delete/{BookmarkId}").ToString());
    }
}