@inject NavigationManager NavigationManager
@inject EditBookmarkService _editService
@inject GetBookmarkService _getService

<EditForm Model="_bookmark" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit" FormName="EditBookmarkForm">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="nameControl" class="form-label">Name</label>
        <InputText @bind-Value="_bookmark.Name" class="form-control" id="nameControl" />
    </div>
    <div class="mb-3">
        <label for="urlControl" class="form-label">Url</label>
        <InputText @bind-Value="_bookmark.Url" class="form-control" id="urlControl" />
    </div>
    <div class="mb-3">
        <label for="descriptionControl" class="form-label">Description</label>
        <InputTextArea @bind-Value="_bookmark.Description" class="form-control" id="descriptionControl" rows="3" />
    </div>

    <button class="btn btn-primary" type="submit">Edit</button>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }
    private UrlBookmark _bookmark = new();

    protected override async Task OnParametersSetAsync()
    {
        _bookmark = await _getService.GetBookmarkById(Id) ?? new();
    }

    private async Task OnValidSubmit()
    {
        await _editService.Edit(_bookmark);
        NavigationManager.NavigateTo(NavigationManager.ToAbsoluteUri("").ToString());
    }

    private async Task OnInvalidSubmit()
    {
        // TODO implement
    }
}