@using UrlSaver.Features.CreateBookmark
@inject NavigationManager Navigation
@inject CreateBookmarkService _service

<EditForm Model="_newBookmark" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit"
          FormName="CreateBookmarkForm">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="nameControl" class="form-label">Name</label>
        <InputText @bind-Value="_newBookmark.Name" class="form-control" id="nameControl" />
    </div>
    <div class="mb-3">
        <label for="urlControl" class="form-label">Url</label>
        <InputText @bind-Value="_newBookmark.Url" class="form-control" id="urlControl" />
    </div>
    <div class="mb-3">
        <label for="descriptionControl" class="form-label">Description</label>
        <InputTextArea @bind-Value="_newBookmark.Description" class="form-control" id="descriptionControl" rows="3" />
    </div>

    <button class="btn btn-primary" type="submit">Create</button>
</EditForm>

@code {
    private UrlBookmark _newBookmark = new();

    private async Task OnValidSubmit()
    {
        await _service.New(_newBookmark);
    }

    private void OnInvalidSubmit(EditContext editContext)
    {
        foreach (var property in typeof(UrlBookmark).GetProperties())
        {
            var field = new FieldIdentifier(_newBookmark, property.Name);

            var messages = editContext.GetValidationMessages(field);

            if (messages.Any())
            {
                Console.WriteLine($"{property.Name}:");

                foreach (var message in messages)
                {
                    Console.WriteLine($"  {message}");
                }
            }
        }
    }
}